{
  "name": "cuphead-guide-backend",
  "version": "2.0.0",
  "description": "API REST do Cuphead Boss Guide (Trabalho Individual II - SCOM)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrar": "node database/migrar.js",
    "db:resetar": "node database/migrar.js --resetar",
    "db:script": "node database/gerarScriptCompleto.js",
    "criar-admin": "node scripts/criarAdmin.js",
    "test": "node --test --test-concurrency=1 tests/",
    "test:unit": "node --test tests/unit/",
    "test:integracao": "node --test --test-concurrency=1 tests/integracao/",
    "bench": "node scripts/benchmark.js"
  },
  "author": "Vitor Correia Mendes",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "supertest": "^7.3.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
