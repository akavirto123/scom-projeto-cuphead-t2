# ------------------------------------------------------------
# Copie este arquivo para ".env" e preencha com os seus valores.
# O arquivo .env NÃO vai para o Git (está no .gitignore).
# ------------------------------------------------------------

# development | test | production
# (em development as respostas de erro incluem detalhes técnicos)
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cuphead_guide
DB_NAME_TEST=cuphead_guide_test
DB_USER=cuphead_app
DB_PASSWORD=troque_esta_senha
DB_POOL_MAX=10

# Sessão: use um valor aleatório e longo. Para gerar um:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque_por_um_valor_aleatorio_longo
SESSION_MAX_AGE_MIN=120
# true somente quando servido via HTTPS
COOKIE_SECURE=false

# Segurança
BCRYPT_COST=12
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_JANELA_MIN=15
RATE_LIMIT_API_MAX=300

# Logs (debug | info | aviso | erro)
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Usado apenas pelo comando "npm run criar-admin"
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@cuphead.local
ADMIN_SENHA=troque_esta_senha_do_admin
